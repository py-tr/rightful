# Copy to .env (never commit .env). Only the first two are required.

# Vultr API key: deploys and removes the demo servers and evaluation fleets (python -m deploy.vultr_deploy ...)
VULTR_API_KEY=

# Vultr Serverless Inference key: the agent's model calls (live demo, local demo, evaluation)
VULTR_INFERENCE_API_KEY=

# Optional: publish each run's signed record to Vultr Object Storage (all four must be set, otherwise it is off)
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_KEY=
EVIDENCE_S3_SECRET=
