# The task sandbox: Python + the credential-free helpdesk SDK, nothing else. Runs as an unprivileged user.
FROM python:3.12-slim
RUN pip install --no-cache-dir httpx==0.27.2 && useradd -u 10001 -m agent
COPY agent/sdk/helpdesk.py /opt/sdk/helpdesk.py
COPY sandbox/probe.py /opt/probe.py
ENV PYTHONPATH=/opt/sdk PYTHONDONTWRITEBYTECODE=1 GATE_URL=http://gate:8080
USER agent
WORKDIR /tmp
