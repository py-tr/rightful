{
  "pack": "helpdesk",
  "version": 1,
  "realm": "corp",
  "static_get_prefixes": [],
  "read_fields": {
    "/admin/realms/{realm}/users": ["id", "username", "firstName", "lastName", "email", "emailVerified", "enabled",
                                    "createdTimestamp", "totp", "requiredActions", "access", "notBefore"],
    "/admin/realms/{realm}/users/{user}": ["id", "username", "firstName", "lastName", "email", "emailVerified",
                                           "enabled", "createdTimestamp", "totp", "requiredActions", "access",
                                           "notBefore", "userProfileMetadata"],
    "/admin/realms/{realm}/users/{user}/unmanagedAttributes": []
  },
  "read_query": {
    "keys": [
      "search",
      "first",
      "max",
      "briefRepresentation",
      "exact",
      "username",
      "email",
      "enabled",
      "type",
      "userProfileMetadata"
    ],
    "value_regex": "^[A-Za-z0-9 ._@:-]{0,64}$",
    "empty_only": ["q"]
  },
  "reads": [
    "/admin/serverinfo",
    "/admin/master/console/whoami",
    "/admin/realms/{realm}",
    "/admin/realms/{realm}/ui-ext/realms/names",
    "/admin/realms/{realm}/ui-ext/brute-force-user/{user}",
    "/admin/realms/{realm}/users",
    "/admin/realms/{realm}/users/count",
    "/admin/realms/{realm}/users/{user}",
    "/admin/realms/{realm}/users/{user}/credentials",
    "/admin/realms/{realm}/users/{user}/sessions",
    "/admin/realms/{realm}/users/{user}/groups",
    "/admin/realms/{realm}/users/{user}/role-mappings",
    "/admin/realms/{realm}/users/{user}/configured-user-storage-credential-types",
    "/admin/realms/{realm}/ui-ext/brute-force-user",
    "/admin/realms/{realm}/ui-ext/info",
    "/admin/realms/{realm}/users/profile",
    "/admin/realms/{realm}/attack-detection/brute-force/users/{user}",
    "/admin/realms/{realm}/users/{user}/unmanagedAttributes",
    "/admin/realms/{realm}/authentication/required-actions"
  ],
  "writes": {
    "reset_password": {
      "method": "PUT",
      "path": "/admin/realms/{realm}/users/{user}/reset-password",
      "body": {
        "type": "object",
        "fields": {
          "type": {
            "enum": [
              "password"
            ]
          },
          "temporary": {
            "enum": [
              true
            ]
          },
          "value": {
            "type": "string",
            "override": "broker_secret"
          }
        }
      },
      "receipt": "owner",
      "label": "reset"
    },
    "send_actions_email": {
      "method": "PUT",
      "path": "/admin/realms/{realm}/users/{user}/execute-actions-email",
      "query": {
        "lifespan": "^[0-9]{2,5}$"
      },
      "body": {
        "type": "array_enum",
        "enum": [
          "UPDATE_PASSWORD",
          "CONFIGURE_TOTP"
        ]
      },
      "receipt": "owner",
      "label": "email"
    },
    "remove_credential": {
      "method": "DELETE",
      "path": "/admin/realms/{realm}/users/{user}/credentials/{cred}",
      "body": {
        "type": "none"
      },
      "receipt": "owner",
      "label": "rmcred"
    },
    "logout_sessions": {
      "method": "POST",
      "path": "/admin/realms/{realm}/users/{user}/logout",
      "body": {
        "type": "none"
      },
      "receipt": "owner",
      "label": "logout"
    },
    "change_email": {
      "method": "PUT",
      "path": "/admin/realms/{realm}/users/{user}",
      "body": {
        "type": "object",
        "fields": {
          "email": {
            "type": "string",
            "regex": "^[^@\\s]{1,64}@[^@\\s]{1,190}$",
            "required": true
          }
        }
      },
      "receipt": "contact",
      "label": "emailchg"
    }
  },
  "approvers": {
    "owner": "the account owner's registered device (CIBA push to the target user)",
    "manager": "the target user's manager, read from the managed user-profile attribute 'manager' (admins, including the broker, can view it; edit permission is granted to nobody, so no admin-API caller can change it; measured by devenv/invariant_probe.py)",
    "contact": "the target user's manager (a contact change never relies on the contact being changed)"
  },
  "composites": {
    "mfa_reenroll_owner": {
      "method": "POST",
      "path": "/gate/v1/actions/mfa-reenroll/{user}",
      "receipt": "owner",
      "label": "reenroll",
      "steps": ["remove_otp_credentials", "send_actions_email:CONFIGURE_TOTP", "notify_owner"],
      "why": "Added after the gate-on evaluation (post-measurement; the published numbers are on the pack without it): a new or replaced phone while the owner can still approve on the registered device. The OWNER approves the exact request; the re-enrolment link goes only to the email on file. The manager path (mfa_recovery_lost_device) stays for a device that is really lost."
    },
    "mfa_recovery_lost_device": {
      "method": "POST",
      "path": "/gate/v1/actions/mfa-recovery-lost-device/{user}",
      "receipt": "manager",
      "label": "mfarecov",
      "steps": [
        "remove_otp_credentials",
        "send_actions_email:CONFIGURE_TOTP",
        "notify_owner"
      ],
      "why": "The caller says the registered device is lost, so the owner cannot approve on it. A manager approves after confirming through a channel they already trust; the re-enrolment link (10 minutes, single use) goes only to the email on file; the owner is notified on every channel, including the device said to be lost, with a cancel button during the cooling-off. Sessions are NOT ended: the corporate mailbox sits behind the lost MFA, so the existing session is the honest user's way in."
    },
    "compromise_response": {
      "method": "POST",
      "path": "/gate/v1/actions/compromise-response/{user}",
      "receipt": "owner",
      "label": "compromise",
      "steps": [
        "reset_password_oob",
        "logout_sessions",
        "send_actions_email:CONFIGURE_TOTP",
        "notify_owner"
      ],
      "why": "The password may have leaked: one owner approval for a fixed, pre-declared set executed by the broker. Sessions ARE ended here, because the threat is a known password."
    }
  },
  "action_link_lifespan_seconds": 600,
  "cooling_off_seconds": {
    "default": 60,
    "privileged": 600
  },
  "privileged_attribute": "privileged",
  "decline_tripwire_seconds": 86400,
  "quarantine_paths": [
    "/events",
    "/admin-events",
    "/role-mappings",
    "/clients",
    "/authentication",
    "/identity-provider",
    "/roles",
    "/components",
    "/keys"
  ]
}